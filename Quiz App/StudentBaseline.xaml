<Window x:Class="Quiz_App.StudentBaseline"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentBaseline" Height="450" Width="800">
    <Grid Width="800" Height="429">
        <Label x:Name="lblTitle" Content="Welcome. This is a simple baseline test to determine your writing level. &#xD;&#xA;Please read the following statement and write your description in the answer box below." Margin="0,40,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="15"/>
        <TextBlock x:Name="txtStatement" HorizontalAlignment="Center" Margin="0,109,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="400" Height="50"/>
        <TextBox x:Name="txtAnswer" HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="50"/>
        <Button x:Name="btnSubmit" Content="Submit" HorizontalAlignment="Center" Margin="0,302,0,0" VerticalAlignment="Top" Click="btnSubmit_Click"/>
    </Grid>
</Window>
