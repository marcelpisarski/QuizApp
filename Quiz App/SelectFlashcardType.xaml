<Window x:Class="Quiz_App.SelectFlashcardType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="SelectFlashcardType" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnWrongQuizAnswers" Content="Wrong quiz answers" HorizontalAlignment="Left" Margin="526,150,0,0" VerticalAlignment="Top" Click="btnWrongQuizAnswers_Click"/>
        <Button x:Name="btnPreviousQuizzes" Content="Previous quizzes" HorizontalAlignment="Left" Margin="163,150,0,0" VerticalAlignment="Top" Click="btnPreviousQuizzes_Click"/>
        <Button x:Name="btnAllQuestions" Content="All questions" HorizontalAlignment="Center" Margin="0,150,0,0" VerticalAlignment="Top" Click="btnAllQuestions_Click"/>
        <CheckBox Content="Randomise" HorizontalAlignment="Center" Margin="0,246,0,0" VerticalAlignment="Top" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

    </Grid>
</Window>
