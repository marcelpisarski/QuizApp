<Window x:Class="Quiz_App.SelectFlashcardType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="SelectFlashcardType" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <Button x:Name="btnWrongQuizAnswers" Content="Wrong quiz answers" HorizontalAlignment="Left" Margin="549,0,0,0" VerticalAlignment="Center" Click="btnWrongQuizAnswers_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="200" Height="100" FontSize="20"/>
        <Button x:Name="btnPreviousQuizzes" Content="Previous quizzes" HorizontalAlignment="Left" Margin="49,0,0,0" VerticalAlignment="Center" Click="btnPreviousQuizzes_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="200" Height="100" FontSize="20"/>
        <Button x:Name="btnAllQuestions" Content="All questions" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnAllQuestions_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="200" Height="100" FontSize="20"/>
        <CheckBox Content="Randomise" HorizontalAlignment="Center" Margin="0,306,0,0" VerticalAlignment="Top" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked" FontFamily="Tahoma" FontSize="20"/>

    </Grid>
</Window>
