<Window x:Class="Quiz_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Width="800" Height="430">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="99*"/>
            <ColumnDefinition Width="101*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtUsername" HorizontalAlignment="Center" Margin="0,116,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240" Height="36" Grid.ColumnSpan="2"/>
        <Button x:Name="btnRegister" Content="Register" HorizontalAlignment="Left" Margin="348,323,0,0" VerticalAlignment="Top" Height="27" Width="104" Click="btnRegister_Click" Grid.ColumnSpan="2"/>
        <Button x:Name="btnLogin" Content="Login" HorizontalAlignment="Left" Margin="348,236,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="52" Width="104" Grid.ColumnSpan="2" Click="btnLogin_Click">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Label x:Name="lblUsername" Content="Username" HorizontalAlignment="Left" Margin="280,90,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.612,0.463"/>
        <Label x:Name="lblPassword" Content="Password" HorizontalAlignment="Left" Margin="280,155,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.562,0.383"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="280,186,0,0" VerticalAlignment="Top" Width="240" Height="36" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
