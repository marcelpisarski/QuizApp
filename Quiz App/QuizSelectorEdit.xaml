<Window x:Class="Quiz_App.QuizSelectorEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="QuizSelectorEdit" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnCancelQuizEdit" Content="Close" HorizontalAlignment="Left" Margin="160,240,0,0" VerticalAlignment="Top" Click="btnCancelQuizEdit_Click"/>
        <Button x:Name="btnSelectQuiz" Content="Select Quiz" HorizontalAlignment="Left" Margin="308,240,0,0" VerticalAlignment="Top" Click="btnSelectQuiz_Click"/>
        <DataGrid x:Name="dtgQuizList" d:ItemsSource="{d:SampleData ItemCount=5}" CanUserAddRows="False" AutoGenerateColumns="False" Margin="63,48,319,217">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quiz Id" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Quiz Topic" Binding="{Binding Topic}" />
                <DataGridTextColumn Header="Quiz Title" Binding="{Binding Title}" />
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnDeleteQuiz" Content="Delete Quiz" HorizontalAlignment="Left" Margin="400,240,0,0" VerticalAlignment="Top" Click="btnDeleteQuiz_Click"/>

    </Grid>
</Window>
