<Window x:Class="Quiz_App.StudentMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentMenu" Height="450" Width="800">
    <Grid Width="800" Height="430">
        <Button x:Name="btnOpenQuizzes" Content="Open Quizzes" HorizontalAlignment="Left" Margin="150,165,0,0" VerticalAlignment="Top" Width="200" Height="80" Click="btnOpenQuizzes_Click"/>
        <Button x:Name="btnOpenFlashcards" Content="Open Flashcards" HorizontalAlignment="Left" Margin="457,165,0,0" VerticalAlignment="Top" Width="200" Height="80" Click="btnOpenFlashcards_Click"/>
        <Button x:Name="btnViewResults" Content="View Quiz Results" HorizontalAlignment="Left" Margin="194,275,0,0" VerticalAlignment="Top" Click="btnViewResults_Click"/>
    </Grid>
</Window>
