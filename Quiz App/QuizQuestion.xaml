<Window x:Class="Quiz_App.QuizQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="QuizQuestion" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <TextBox x:Name="txtQuestion" HorizontalAlignment="Center" Margin="0,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="446" Height="65" FontFamily="Tahoma"/>
        <StackPanel Margin="0,180,558,103">
            <RadioButton x:Name="rbSingleAnswer" Content="Single Answer" Checked="rbSingleAnswer_Checked" Unchecked="rbSingleAnswer_UnChecked" FontFamily="Tahoma" Width="184" FontSize="18"/>
            <RadioButton x:Name="rbMultipleChoice" Content="Multiple Choice" Checked="rbMultipleChoice_Checked" Unchecked="rbMultipleChoice_UnChecked" FontFamily="Tahoma" FontSize="18" Width="184"/>

        </StackPanel>

        <Grid x:Name="grdSingleAnswer" Visibility="Collapsed">
            <TextBox x:Name="txtSingleAnswer" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="304" Margin="0,217,0,0" FontFamily="Tahoma"/>
            <Label Content="Type Answer" HorizontalAlignment="Center" Margin="0,177,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" FontWeight="Bold"/>
        </Grid>

        <Grid x:Name="grdMultipleChoice" Height="430" Width="750" Margin="-68,77,118,-73" Visibility="Collapsed">
            <TextBox x:Name="txtOption1" HorizontalAlignment="Center" Margin="0,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="20"/>
            <TextBox x:Name="txtOption2" HorizontalAlignment="Left" Margin="504,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="20"/>
            <TextBox x:Name="txtOption3" HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="20"/>
            <TextBox x:Name="txtOption4" HorizontalAlignment="Left" Margin="504,215,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="20"/>
            <RadioButton x:Name="rbOption1" Content="Option 1" HorizontalAlignment="Left" Margin="315,130,0,0" VerticalAlignment="Top" GroupName="MultipleChoiceOptions" FontFamily="Tahoma" FontSize="18"/>
            <RadioButton x:Name="rbOption2" Content="Option 2" HorizontalAlignment="Left" Margin="504,130,0,0" VerticalAlignment="Top" GroupName="MultipleChoiceOptions" FontFamily="Tahoma" FontSize="18"/>
            <RadioButton x:Name="rbOption3" Content="Option 3" HorizontalAlignment="Left" Margin="315,250,0,0" VerticalAlignment="Top" GroupName="MultipleChoiceOptions" FontFamily="Tahoma" FontSize="18"/>
            <RadioButton x:Name="rbOption4" Content="Option 4" HorizontalAlignment="Left" Margin="504,250,0,0" VerticalAlignment="Top" GroupName="MultipleChoiceOptions" FontFamily="Tahoma" FontSize="18"/>
        </Grid>

        <Label Content="Enter Question" HorizontalAlignment="Center" Margin="0,40,0,0" VerticalAlignment="Top" FontSize="18" FontFamily="Tahoma" FontWeight="Bold"/>
        <Button x:Name="btnAddQuestion" Content="Add Question" HorizontalAlignment="Left" Margin="651,370,0,0" VerticalAlignment="Top" Width="129" Height="36" Click="btnAddQuestion_Click" Background="#FFDBEEF1" FontFamily="Tahoma" FontSize="18"/>
        <Button x:Name="btnCancelQuestion" Content="Cancel" HorizontalAlignment="Left" Margin="544,370,0,0" VerticalAlignment="Top" Width="102" Height="36" Click="btnCancelQuestion_Click" Background="#FFDBEEF1" FontFamily="Tahoma" FontSize="18"/>
    </Grid>
</Window>
