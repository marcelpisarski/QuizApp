<Window x:Class="Quiz_App.StudentResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentResults" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <DataGrid x:Name="dtgStudentResults" AutoGenerateColumns="False" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="63,74,152,74" FontFamily="Tahoma" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quiz Id" Binding="{Binding QuizId}" />
                <DataGridTextColumn Header="Quiz Title" Binding="{Binding QuizTitle}" />
                <DataGridTextColumn Header="Total Marks" Binding="{Binding TotalMarks}" />
                <DataGridTextColumn Header="Student Marks" Binding="{Binding StudentMark}" />
                <DataGridTextColumn Header="Completion Date" Binding="{Binding completionDate}" />
                <DataGridTextColumn Header="Percentage" Binding="{Binding Percentage}" />
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnCloseWindow" Content="Close" HorizontalAlignment="Left" Margin="666,373,0,0" VerticalAlignment="Top" Click="btnCloseWindow_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="102" Height="36" FontSize="18"/>
        <Label Content="Select Quiz" HorizontalAlignment="Left" Margin="284,24,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="20" FontWeight="Bold"/>

    </Grid>
</Window>
