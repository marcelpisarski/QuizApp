<Window x:Class="Quiz_App.StudentResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentResults" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <DataGrid x:Name="dtgStudentResults" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="163,47,163,102" FontFamily="Tahoma" Background="White"/>
        <Button x:Name="btnCloseWindow" Content="Close" HorizontalAlignment="Left" Margin="666,373,0,0" VerticalAlignment="Top" Click="btnCloseWindow_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="102" Height="36" FontSize="18"/>

    </Grid>
</Window>
