<Window x:Class="Quiz_App.StudentFlashcardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentFlashcardWindow" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <Button x:Name="btnFlashcard" HorizontalAlignment="Center" Margin="0,92,0,0" VerticalAlignment="Top" Height="200" Width="400" Click="btnFlashcard_Click" FontFamily="Tahoma" Background="#FFDBEEF1" FontSize="20">
            <TextBlock x:Name="txtAnswerBlock" TextWrapping="Wrap" Text="ANSWER TEXT" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="btnNextFlashcard" Content="Next" HorizontalAlignment="Center" Margin="0,324,0,0" VerticalAlignment="Top" Height="60" Width="136" Click="btnNextFlashcard_Click" FontFamily="Tahoma" Background="#FFDBEEF1" FontSize="18"/>
        <Label Content="Click flashcard below to show answer" HorizontalAlignment="Center" Margin="0,33,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="20" FontWeight="Bold"/>

    </Grid>
</Window>
