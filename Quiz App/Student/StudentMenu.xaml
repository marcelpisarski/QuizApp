<Window x:Class="Quiz_App.StudentMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentMenu" Height="450" Width="800">
    <Grid Width="800" Height="430" Background="#FF77B0AA">
        <Button x:Name="btnOpenQuizzes" Content="Open Quizzes" HorizontalAlignment="Left" Margin="67,115,0,0" VerticalAlignment="Top" Width="300" Height="100" Click="btnOpenQuizzes_Click" FontFamily="Tahoma" Background="#FFDBEEF1" FontSize="20"/>
        <Button x:Name="btnOpenFlashcards" Content="Open Flashcards" HorizontalAlignment="Left" Margin="428,115,0,0" VerticalAlignment="Top" Width="300" Height="100" Click="btnOpenFlashcards_Click" FontFamily="Tahoma" Background="#FFDBEEF1" FontSize="20"/>
        <Button x:Name="btnViewResults" Content="View Quiz Results" HorizontalAlignment="Left" Margin="67,266,0,0" VerticalAlignment="Top" Click="btnViewResults_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="661" Height="50" FontSize="18"/>
        <Label x:Name="lblWelcomeLabel" Content="WELCOME LABEL" HorizontalAlignment="Center" Margin="0,47,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="20" FontWeight="Bold"/>
        <Button x:Name="txtChangePassword" Content="Reset Password" HorizontalAlignment="Left" Margin="428,348,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" Background="#FFF3D7AF" Width="171" Height="39" FontWeight="Bold" Click="txtChangePassword_Click"/>
        <Button x:Name="btnLogout" Content="Logout" HorizontalAlignment="Left" Margin="628,348,0,0" VerticalAlignment="Top" Background="#FFFFC9B9" Height="39" Width="100" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Click="btnLogout_Click"/>
    </Grid>
</Window>
