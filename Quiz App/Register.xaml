<Window x:Class="Quiz_App.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="Register" Height="450" Width="800">
    <Grid Width="800" Height="430">
        <TextBox x:Name="txtRegisterUsername" HorizontalAlignment="Left" Margin="304,115,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240" Height="36"/>
        <Button x:Name="btnRegisterUser" Content="Register User" HorizontalAlignment="Left" Margin="374,344,0,0" VerticalAlignment="Top" Width="104" Height="52" Click="btnRegisterUser_Click"/>
        <Label x:Name="lblUsername" Content="Username" HorizontalAlignment="Left" Margin="304,89,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblPassword" Content="Password" HorizontalAlignment="Left" Margin="306,155,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="lblTeacherQuery" Content="Are you a teacher?" HorizontalAlignment="Left" Margin="304,293,0,0" VerticalAlignment="Top" Checked="lblTeacherQuery_Checked" Unchecked="lblTeacherQuery_UnChecked"/>
        <TextBox x:Name="txtTeacherCode" HorizontalAlignment="Left" Margin="427,292,0,0" TextWrapping="Wrap" Text="Enter Code" VerticalAlignment="Top" Width="120" />
        <Label x:Name="lblConfirmPassword" Content="Confirm Password" HorizontalAlignment="Left" Margin="306,222,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="txtRegisterPassword" HorizontalAlignment="Left" Margin="304,181,0,0" VerticalAlignment="Top" Width="240" Height="36"/>
        <PasswordBox x:Name="txtConfirmPassword" HorizontalAlignment="Left" Margin="304,248,0,0" VerticalAlignment="Top" Width="240" Height="36"/>

    </Grid>
</Window>
