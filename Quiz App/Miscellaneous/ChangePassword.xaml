<Window x:Class="Quiz_App.Miscellaneous.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App.Miscellaneous"
        mc:Ignorable="d"
        Title="ChangePassword" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <TextBox x:Name="txtOldPassword" HorizontalAlignment="Left" Margin="306,87,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240" Height="20"/>
        <TextBox x:Name="txtNewPassword" HorizontalAlignment="Left" Margin="306,165,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240" Height="20"/>
        <TextBox x:Name="txtConfirmPassword" HorizontalAlignment="Left" Margin="306,247,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240" Height="20"/>
        <Label x:Name="lblOldPassword" Content="Old Password" HorizontalAlignment="Left" Margin="304,50,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" FontWeight="Bold"/>
        <Label x:Name="lblNewPassword" Content="New Password" HorizontalAlignment="Left" Margin="304,128,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" FontWeight="Bold"/>
        <Label x:Name="lblConfirmPassword" Content="Confirm New Password" HorizontalAlignment="Left" Margin="304,210,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" FontWeight="Bold"/>
        <Button x:Name="btnChangePassword" Content="Confirm" HorizontalAlignment="Left" Margin="362,284,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" Width="104" Height="52" Background="#FFDBEEF1" Click="btnChangePassword_Click"/>
        <Button x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Left" Margin="362,354,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" Width="104" Height="30" Background="#FFDBEEF1" Click="btnCancel_Click"/>

    </Grid>
</Window>
