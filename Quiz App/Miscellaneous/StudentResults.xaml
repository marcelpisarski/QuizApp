<Window x:Class="Quiz_App.StudentResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentResults" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <DataGrid x:Name="dtgStudentResults" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" AutoGenerateColumns="False" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="108,58,108,90" FontFamily="Tahoma" Background="White" Width="584" Height="290">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quiz Id" Binding="{Binding QuizId}" Width="*"/>
                <DataGridTextColumn Header="Quiz Title" Binding="{Binding QuizTitle}" Width="*"/>
                <DataGridTextColumn Header="Total Marks" Binding="{Binding TotalMarks}" Width="*"/>
                <DataGridTextColumn Header="Student Marks" Binding="{Binding StudentMark}" Width="*"/>
                <DataGridTextColumn Header="Completion Date" Binding="{Binding completionDate}" Width="*"/>
                <DataGridTextColumn Header="Percentage" Binding="{Binding Percentage}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnCloseWindow" Content="Close" HorizontalAlignment="Left" Margin="666,373,0,0" VerticalAlignment="Top" Click="btnCloseWindow_Click" FontFamily="Tahoma" Background="#FFDBEEF1" Width="102" Height="36" FontSize="18"/>
        <Label Content="Quiz Results" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="20" FontWeight="Bold"/>
        <Button x:Name="btnViewQuizQuestions" Content="View Quiz Details" HorizontalAlignment="Left" Margin="498,373,0,0" VerticalAlignment="Top" Background="#FFDBEEF1" FontFamily="Tahoma" FontSize="18" Height="36" Width="150" Click="btnViewQuizQuestions_Click"/>

    </Grid>
</Window>
