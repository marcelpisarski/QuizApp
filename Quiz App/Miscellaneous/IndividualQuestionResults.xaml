<Window x:Class="Quiz_App.Miscellaneous.IndividualQuestionResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App.Miscellaneous"
        mc:Ignorable="d"
        Title="IndividualQuestionResults" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <DataGrid x:Name="dtgResultList" d:ItemsSource="{d:SampleData ItemCount=5}" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" AutoGenerateColumns="False" Margin="310,59,26,63" FontFamily="Tahoma" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Question Id" Binding="{Binding QuestionId}" Width="*"/>
                <DataGridTextColumn Header="Question" Binding="{Binding QuestionText}" Width="*"/>
                <DataGridTextColumn Header="Question Type" Binding="{Binding QuestionType}" Width="*"/>
                <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Question Results" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="20" FontWeight="Bold"/>
        <Button x:Name="btnClose" Content="Close" HorizontalAlignment="Left" Margin="672,371,0,0" VerticalAlignment="Top" Background="#FFDBEEF1" FontFamily="Tahoma" FontSize="18" Width="102" Height="36" Click="btnClose_Click"/>

        <lvc:PieChart Series="{Binding PieChart}" LegendPosition="Bottom"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="233" Height="254" Margin="0,105,516,0"/>
        <Label Content="Percentage Answered Correct" HorizontalAlignment="Left" Margin="10,59,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="18" FontWeight="Bold"/>

    </Grid>
</Window>
