<Window x:Class="Quiz_App.Miscellaneous.IndividualQuestionResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App.Miscellaneous"
        mc:Ignorable="d"
        Title="IndividualQuestionResults" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <DataGrid x:Name="dtgResultList" d:ItemsSource="{d:SampleData ItemCount=5}" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" AutoGenerateColumns="False" Margin="108,59,108,90" FontFamily="Tahoma" Width="584" Height="290">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Question Id" Binding="{Binding QuestionId}" Width="*"/>
                <DataGridTextColumn Header="Question" Binding="{Binding QuestionText}" Width="*"/>
                <DataGridTextColumn Header="Question Type" Binding="{Binding QuestionType}" Width="*"/>
                <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Question Results" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Tahoma" FontSize="20" FontWeight="Bold"/>
        <Button x:Name="btnClose" Content="Close" HorizontalAlignment="Left" Margin="672,375,0,0" VerticalAlignment="Top" Background="#FFDBEEF1" FontFamily="Tahoma" FontSize="18" Width="102" Height="36" Click="btnClose_Click"/>

    </Grid>
</Window>
