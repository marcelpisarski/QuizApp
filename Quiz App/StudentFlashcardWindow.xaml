<Window x:Class="Quiz_App.StudentFlashcardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_App"
        mc:Ignorable="d"
        Title="StudentFlashcardWindow" Height="450" Width="800">
    <Grid Background="#FF77B0AA">
        <Button x:Name="btnFlashcard" Content="FLASHCARD DATA" HorizontalAlignment="Center" Margin="0,45,0,0" VerticalAlignment="Top" Height="200" Width="400" Click="btnFlashcard_Click" FontFamily="Tahoma" Background="#FFDBEEF1" FontSize="20"/>
        <Button x:Name="btnNextFlashcard" Content="Next" HorizontalAlignment="Center" Margin="0,292,0,0" VerticalAlignment="Top" Height="60" Width="136" Click="btnNextFlashcard_Click" FontFamily="Tahoma" Background="#FFDBEEF1" FontSize="18"/>

    </Grid>
</Window>
